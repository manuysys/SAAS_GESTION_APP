{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/PROJECT_STATUS.md",
    "docs/DECISIONS.md"
  ],
  "formatter": true,
  "experimental": {
    "todo": true,
    "subagent_depth": 2
  },
  "worktree": {
    "directory": ".lane/trees"
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item *", "effect": "ask" },
    { "action": "shell", "resource": "npm publish *", "effect": "deny" },
    { "action": "read", "resource": ".env*", "effect": "ask" },
    { "action": "read", "resource": ".env.example", "effect": "allow" },
    { "action": "edit", "resource": ".env*", "effect": "deny" },
    { "action": "edit", "resource": ".env.example", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
          "X-MCP-Toolsets": "repos,issues,pull_requests"
        },
        "disabled": true
      },
      "postgres": {
        "type": "local",
        "command": ["uvx", "postgres-mcp", "--access-mode=restricted"],
        "environment": {
          "DATABASE_URI": "{env:DATABASE_URL_SYNC}"
        },
        "disabled": true
      }
    }
  }
}
