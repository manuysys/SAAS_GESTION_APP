# Aplicación
APP_NAME="SaaS Gestión"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_CORS_ORIGINS=["http://localhost:3000"]

# Base de datos local (PostgreSQL portable en el puerto 55432)
DATABASE_URL=postgresql+asyncpg://saas:saas_dev_password@localhost:55432/saas_gestion_dev
DATABASE_URL_SYNC=postgresql+psycopg://saas:saas_dev_password@localhost:55432/saas_gestion_dev
TEST_DATABASE_URL=postgresql+asyncpg://saas:saas_dev_password@localhost:55432/saas_gestion_test

# Autenticación (generar valores reales con openssl rand -hex 32)
JWT_SECRET=change-me-in-local-env
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=localhost

# Almacenamiento local en desarrollo
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.local/uploads
STORAGE_MAX_FILE_MB=10

# IA (opcional en desarrollo)
AI_PROVIDER=deterministic
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MONTHLY_TOKEN_LIMIT=200000
AI_INPUT_COST_PER_1K=0
AI_OUTPUT_COST_PER_1K=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# Panel global del SaaS (lista JSON de emails)
PLATFORM_ADMIN_EMAILS=[]

# WhatsApp Business Cloud API oficial
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=

# Rate limiting compartido en PostgreSQL (fallback en memoria si la DB falla)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PUBLIC_PER_MINUTE=30
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_MINUTES=15
AUDIT_ENABLED=true

# Hosts permitidos por TrustedHostMiddleware (JSON)
ALLOWED_HOSTS=["*"]
