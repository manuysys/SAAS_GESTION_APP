# Aplicación
APP_NAME="SaaS Gestión"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_CORS_ORIGINS=["http://localhost:3000"]

# Base de datos local (PostgreSQL portable en el puerto 55432)
DATABASE_URL=postgresql+asyncpg://saas:saas_dev_password@localhost:55432/saas_gestion_dev
DATABASE_URL_SYNC=postgresql+psycopg://saas:saas_dev_password@localhost:55432/saas_gestion_dev
TEST_DATABASE_URL=postgresql+asyncpg://saas:saas_dev_password@localhost:55432/saas_gestion_test

# Autenticación (generar valores reales con openssl rand -hex 32)
JWT_SECRET=change-me-in-local-env
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Almacenamiento local en desarrollo
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.local/uploads
STORAGE_MAX_FILE_MB=10

# IA (opcional en desarrollo)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# Integraciones futuras (no configuradas)
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
